    <string>Микрофон используется для разговора с Proto-Mind через OpenAI GPT Live. Звук передаётся OpenAI только во время включённого разговора.</string>
  <key>CFBundleName</key><string>Proto-Mind Native</string>
  <key>CFBundleDisplayName</key><string>Proto-Mind Native</string>
  <key>CFBundleExecutable</key><string>ProtoMindNative</string>
  <key>CFBundleIdentifier</key><string>local.proto-mind.native</string>
  <key>CFBundleVersion</key><string>75</string>
  <key>CFBundleShortVersionString</key><string>0.61.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>ProtoMindCube</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- User-directed web browsing; URLSession keeps the default transport policy. -->
